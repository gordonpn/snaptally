{
  "name": "snaptally",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "astro build",
    "preview": "astro preview",
    "dev": "astro build && wrangler pages dev ./dist",
    "lint": "biome check . && node scripts/sql-lint.mjs",
    "format": "biome format --write .",
    "test": "node --experimental-test-coverage --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=85 --test-coverage-exclude=\"tests/**\" --import ./tests/register-loader.js --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:coverage": "node --input-type=module --eval \"import { mkdirSync } from 'node:fs'; mkdirSync('coverage', { recursive: true })\" && node --experimental-test-coverage --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=85 --test-coverage-exclude=\"tests/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --import ./tests/register-loader.js --test tests/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.backfill.json && tsc --project tsconfig.config.json",
    "db:migrate:local": "wrangler d1 migrations apply budget-db --local",
    "test:integration": "node --test tests/integration/*.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@cloudflare/workers-types": "^5.20261120.1",
    "@playwright/test": "^1.65.1",
    "@tabler/icons-astro": "^3.51.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/alpinejs": "^3.17.0",
    "@types/node": "^26.6.6",
    "astro": "^7.4.13",
    "daisyui": "^5.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.165.0"
  },
  "dependencies": {
    "alpinejs": "^3.17.5"
  }
}
