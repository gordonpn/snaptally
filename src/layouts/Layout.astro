---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "SnapTally" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
  </head>
  <body class="h-dvh overflow-hidden select-none bg-base-100 text-base-content antialiased">
    <slot />
    <script src="../scripts/app.ts"></script>
  </body>
</html>
