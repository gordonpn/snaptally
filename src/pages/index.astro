---
import {
  IconBackspace,
  IconCalendar,
  IconCreditCard,
  IconHistory,
  IconReceipt2,
  IconSettings,
  IconX,
} from "@tabler/icons-astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="SnapTally Intake">
  <div
    class="flex flex-col h-full max-w-md mx-auto px-4 py-2 justify-between overflow-y-auto no-scrollbar"
    x-data="intakeForm"
  >
    <!-- Header -->
    <header class="flex items-center justify-between pb-2 border-b border-base-300">
      <div class="flex items-center gap-2">
        <IconReceipt2 class="w-6 h-6 text-primary" />
        <span class="text-lg font-bold tracking-tight">SnapTally</span>
      </div>

      <!-- Date selector chip -->
      <div class="relative focus-within:ring-2 focus-within:ring-primary rounded-full">
        <input
          type="date"
          class="absolute inset-0 opacity-0 cursor-pointer w-full h-full"
          :value="date"
          @change="setDate($event.target.value)"
          aria-label="Transaction Date"
        />
        <button
          type="button"
          class="btn btn-xs sm:btn-sm rounded-full gap-1 min-h-[44px] pointer-events-none"
          :class="isBackfill ? 'btn-warning text-warning-content' : 'btn-ghost bg-base-200'"
        >
          <IconCalendar class="w-4 h-4" />
          <span x-text="isToday ? 'Today' : date"></span>
        </button>
      </div>

      <!-- Actions: Recent, Outbox & Settings -->
      <div class="flex items-center gap-1">
        <button
          type="button"
          x-show="outboxCount > 0"
          x-transition
          class="badge badge-warning badge-sm gap-1 font-mono cursor-pointer min-h-[28px] px-2"
          @click="syncPendingOutbox(true)"
          aria-label="Pending offline transactions"
          title="Pending offline transactions. Click to sync."
        >
          <span x-show="isSyncing" class="loading loading-spinner loading-xs"></span>
          <span x-text="outboxCount"></span>
        </button>
        <button
          type="button"
          class="btn btn-ghost btn-circle btn-sm min-h-[44px] min-w-[44px]"
          @click="toggleRecent()"
          aria-label="Recent Transactions"
        >
          <IconHistory class="w-5 h-5" />
        </button>
        <button
          type="button"
          class="btn btn-ghost btn-circle btn-sm min-h-[44px] min-w-[44px] relative"
          @click="openSettings()"
          aria-label="Settings"
        >
          <IconSettings class="w-5 h-5" />
          <span
            class="absolute top-2 right-2 w-2.5 h-2.5 rounded-full ring-2 ring-base-100"
            :class="hasToken ? 'bg-success' : 'bg-warning'"
          ></span>
        </button>
      </div>
    </header>

    <!-- Status Message Alert -->
    <div
      x-show="statusMessage"
      x-transition
      class="text-xs text-center py-1 font-medium"
      :class="isError ? 'text-error' : 'text-success'"
      role="status"
      aria-live="polite"
      x-text="statusMessage"
    ></div>

    <!-- Amount Display (Non-input styled container) -->
    <section class="flex flex-col items-center justify-center py-1 sm:py-2 select-none">
      <div
        class="text-5xl sm:text-6xl font-mono font-bold tracking-tight text-primary transition-all duration-75"
        x-text="formattedAmount"
        aria-live="off"
      >
        $0.00
      </div>
    </section>

    <!-- Selectors Section -->
    <section class="space-y-2 text-xs sm:text-sm">
      <!-- Merchant Chips -->
      <div class="space-y-1">
        <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5">
          <template x-for="m in frequentMerchants" :key="m">
            <button
              type="button"
              class="btn btn-xs sm:btn-sm rounded-full whitespace-nowrap min-h-[44px]"
              :class="merchant === m && !isCustomMerchant ? 'btn-primary text-primary-content' : 'btn-ghost bg-base-200'"
              @click="selectMerchant(m)"
              x-text="m"
            ></button>
          </template>
          <button
            type="button"
            class="btn btn-xs sm:btn-sm rounded-full whitespace-nowrap min-h-[44px]"
            :class="isCustomMerchant ? 'btn-primary text-primary-content' : 'btn-ghost bg-base-200'"
            @click="toggleCustomMerchant()"
          >
            Other...
          </button>
        </div>
        <div x-show="isCustomMerchant" x-transition>
          <input
            type="text"
            list="merchants-list"
            placeholder="Type merchant name..."
            class="input input-sm input-bordered w-full rounded-lg"
            x-model="customMerchantInput"
            @input="updateCustomMerchant($event.target.value)"
          />
          <datalist id="merchants-list">
            <template x-for="m in allMerchants" :key="m">
              <option :value="m" x-text="m"></option>
            </template>
          </datalist>
        </div>
      </div>

      <!-- Parent Bucket Chips -->
      <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5">
        <template x-for="b in buckets" :key="b">
          <button
            type="button"
            class="btn btn-xs sm:btn-sm rounded-full whitespace-nowrap min-h-[44px]"
            :class="parentBucket === b ? 'btn-secondary text-secondary-content' : 'btn-ghost bg-base-200'"
            @click="selectBucket(b)"
            x-text="b"
          ></button>
        </template>
      </div>

      <!-- Dynamic Subcategory Chips -->
      <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5">
        <template x-for="s in subcategories" :key="s">
          <button
            type="button"
            class="btn btn-xs sm:btn-sm rounded-full whitespace-nowrap min-h-[44px]"
            :class="subcategory === s ? 'btn-neutral text-neutral-content' : 'btn-outline border-base-300'"
            @click="selectSubcategory(s)"
            x-text="s"
          ></button>
        </template>
      </div>

      <!-- Card Selection Chips -->
      <div class="space-y-1">
        <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5">
          <span class="text-base-content/60 flex items-center mr-1">
            <IconCreditCard class="w-4 h-4" />
          </span>
          <template x-for="c in cards" :key="c">
            <button
              type="button"
              class="btn btn-xs sm:btn-sm rounded-full whitespace-nowrap min-h-[44px]"
              :class="card === c && !isCustomCard ? 'btn-accent text-accent-content' : 'btn-ghost bg-base-200'"
              @click="selectCard(c)"
              x-text="c"
            ></button>
          </template>
          <button
            type="button"
            class="btn btn-xs sm:btn-sm rounded-full whitespace-nowrap min-h-[44px]"
            :class="isCustomCard ? 'btn-accent text-accent-content' : 'btn-ghost bg-base-200'"
            @click="toggleCustomCard()"
          >
            Other...
          </button>
        </div>
        <div x-show="isCustomCard" x-transition>
          <input
            type="text"
            placeholder="Type card name..."
            class="input input-sm input-bordered w-full rounded-lg"
            x-model="customCardInput"
            @input="updateCustomCard($event.target.value)"
          />
        </div>
      </div>
    </section>

    <!-- Built-in Numeric Keypad (3x4 Grid) -->
    <section class="grid grid-cols-3 gap-2 pt-2 select-none">
      <button
        type="button"
        class="btn btn-ghost bg-base-200 text-2xl font-semibold h-12 sm:h-14 rounded-2xl active:scale-95 transition-transform min-h-[48px]"
        :disabled="loading"
        @click="pressDigit(1)"
      >
        1
      </button>
      <button
        type="button"
        class="btn btn-ghost bg-base-200 text-2xl font-semibold h-12 sm:h-14 rounded-2xl active:scale-95 transition-transform min-h-[48px]"
        :disabled="loading"
        @click="pressDigit(2)"
      >
        2
      </button>
      <button
        type="button"
        class="btn btn-ghost bg-base-200 text-2xl font-semibold h-12 sm:h-14 rounded-2xl active:scale-95 transition-transform min-h-[48px]"
        :disabled="loading"
        @click="pressDigit(3)"
      >
        3
      </button>

      <button
        type="button"
        class="btn btn-ghost bg-base-200 text-2xl font-semibold h-12 sm:h-14 rounded-2xl active:scale-95 transition-transform min-h-[48px]"
        :disabled="loading"
        @click="pressDigit(4)"
      >
        4
      </button>
      <button
        type="button"
        class="btn btn-ghost bg-base-200 text-2xl font-semibold h-12 sm:h-14 rounded-2xl active:scale-95 transition-transform min-h-[48px]"
        :disabled="loading"
        @click="pressDigit(5)"
      >
        5
      </button>
      <button
        type="button"
        class="btn btn-ghost bg-base-200 text-2xl font-semibold h-12 sm:h-14 rounded-2xl active:scale-95 transition-transform min-h-[48px]"
        :disabled="loading"
        @click="pressDigit(6)"
      >
        6
      </button>

      <button
        type="button"
        class="btn btn-ghost bg-base-200 text-2xl font-semibold h-12 sm:h-14 rounded-2xl active:scale-95 transition-transform min-h-[48px]"
        :disabled="loading"
        @click="pressDigit(7)"
      >
        7
      </button>
      <button
        type="button"
        class="btn btn-ghost bg-base-200 text-2xl font-semibold h-12 sm:h-14 rounded-2xl active:scale-95 transition-transform min-h-[48px]"
        :disabled="loading"
        @click="pressDigit(8)"
      >
        8
      </button>
      <button
        type="button"
        class="btn btn-ghost bg-base-200 text-2xl font-semibold h-12 sm:h-14 rounded-2xl active:scale-95 transition-transform min-h-[48px]"
        :disabled="loading"
        @click="pressDigit(9)"
      >
        9
      </button>

      <button
        type="button"
        class="btn btn-ghost bg-base-200/60 text-lg font-semibold h-12 sm:h-14 rounded-2xl active:scale-95 transition-transform min-h-[48px]"
        :disabled="loading"
        @click="pressClear()"
        aria-label="Clear Amount"
      >
        C
      </button>
      <button
        type="button"
        class="btn btn-ghost bg-base-200 text-2xl font-semibold h-12 sm:h-14 rounded-2xl active:scale-95 transition-transform min-h-[48px]"
        :disabled="loading"
        @click="pressDigit(0)"
      >
        0
      </button>
      <button
        type="button"
        class="btn btn-ghost bg-base-200/60 text-lg font-semibold h-12 sm:h-14 rounded-2xl active:scale-95 transition-transform min-h-[48px] flex items-center justify-center"
        :disabled="loading"
        @click="pressBackspace()"
        aria-label="Backspace"
      >
        <IconBackspace class="w-6 h-6" />
      </button>
    </section>

    <!-- Action Button -->
    <footer class="pt-2 pb-1">
      <button
        type="button"
        class="btn btn-primary w-full h-12 sm:h-14 rounded-2xl text-base font-semibold min-h-[48px]"
        :disabled="loading || amountCents <= 0"
        @click="submitTransaction()"
      >
        <span x-show="!loading">Save Transaction</span>
        <span x-show="loading" class="loading loading-spinner loading-sm"></span>
      </button>
    </footer>

    <!-- Settings Modal -->
    <dialog class="modal" :class="{ 'modal-open': isSettingsOpen }">
      <div class="modal-box p-5 max-w-sm rounded-2xl max-h-[85vh] overflow-y-auto">
        <h3 class="font-bold text-lg">Settings</h3>
        <p class="text-xs text-base-content/70 mt-1">
          Configure pre-shared API bearer token stored locally in browser storage.
        </p>
        <div class="form-control my-4">
          <label class="label py-1" for="api-token-input">
            <span class="label-text font-medium text-xs">API Bearer Token</span>
          </label>
          <input
            type="password"
            id="api-token-input"
            class="input input-bordered input-sm w-full rounded-lg"
            placeholder="Paste token here"
            x-model="settingsTokenInput"
          />
        </div>
        <div class="modal-action mt-4 flex justify-end gap-2">
          <button type="button" class="btn btn-sm btn-ghost rounded-lg min-h-[44px]" @click="closeSettings()">
            Cancel
          </button>
          <button type="button" class="btn btn-sm btn-primary rounded-lg min-h-[44px]" @click="saveToken()">
            Save Token
          </button>
        </div>
      </div>
    </dialog>

    <!-- Recent Transactions Modal -->
    <dialog class="modal" :class="{ 'modal-open': isRecentOpen }">
      <div class="modal-box p-5 max-w-sm rounded-2xl max-h-[85vh] flex flex-col">
        <div class="flex items-center justify-between pb-3 border-b border-base-300">
          <h3 class="font-bold text-lg flex items-center gap-2">
            <IconHistory class="w-5 h-5 text-primary" />
            Recent Activity
          </h3>
          <button
            type="button"
            class="btn btn-ghost btn-circle btn-sm min-h-[44px] min-w-[44px]"
            @click="toggleRecent()"
            aria-label="Close Recent Transactions"
          >
            <IconX class="w-4 h-4" />
          </button>
        </div>

        <div class="overflow-y-auto flex-1 py-2 divide-y divide-base-200">
          <template x-if="recentTransactions.length === 0">
            <p class="text-sm text-base-content/60 text-center py-6">
              No recent transactions recorded yet.
            </p>
          </template>

          <template x-for="tx in recentTransactions" :key="tx.id">
            <div class="py-2.5 flex items-center justify-between">
              <div class="min-w-0 pr-2">
                <div class="font-semibold text-sm truncate" x-text="tx.merchant"></div>
                <div class="text-xs text-base-content/60 flex items-center gap-1.5 mt-0.5">
                  <span x-text="tx.subcategory"></span>
                  <span>&bull;</span>
                  <span x-text="tx.card"></span>
                  <span>&bull;</span>
                  <span x-text="tx.date"></span>
                </div>
              </div>
              <div class="font-mono font-bold text-sm text-right whitespace-nowrap">
                $<span x-text="Number(tx.net_spend).toFixed(2)"></span>
              </div>
            </div>
          </template>
        </div>

        <div class="pt-2 border-t border-base-300">
          <button
            type="button"
            class="btn btn-sm btn-ghost w-full rounded-lg min-h-[44px]"
            @click="toggleRecent()"
          >
            Close
          </button>
        </div>
      </div>
    </dialog>
  </div>
</Layout>
