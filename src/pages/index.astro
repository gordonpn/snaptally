---
import { IconCreditCard, IconReceipt2, IconSettings } from "@tabler/icons-astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="SnapTally Intake">
  <main class="mx-auto max-w-md p-4 space-y-6">
    <header class="flex items-center justify-between pb-2 border-b border-base-300">
      <div class="flex items-center space-x-2">
        <IconReceipt2 class="w-6 h-6 text-primary" />
        <h1 class="text-xl font-bold tracking-tight">SnapTally</h1>
      </div>
      <button type="button" class="btn btn-ghost btn-circle btn-sm" aria-label="Settings">
        <IconSettings class="w-5 h-5" />
      </button>
    </header>

    <section
      class="card bg-base-200 shadow-sm"
      x-data="{
        amount: '',
        card: '',
        category: '',
        merchant: '',
        loading: false,
        statusMessage: '',
        isError: false,
        async submitTransaction() {
          this.loading = true;
          this.statusMessage = 'Submitting transaction...';
          this.isError = false;

          const payload = {
            amount: parseFloat(this.amount),
            card: this.card,
            category: this.category,
            merchant: this.merchant,
          };

          try {
            const response = await fetch('/api/transactions', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });

            const data = await response.json().catch(() => null);
            if (response.status === 201 && data?.ok) {
              this.statusMessage = `Transaction saved. ID: ${data.id}`;
              this.amount = '';
              this.card = '';
              this.category = '';
              this.merchant = '';
            } else {
              this.isError = true;
              this.statusMessage = `Error: ${data?.error || response.statusText}`;
            }
          } catch {
            this.isError = true;
            this.statusMessage = 'Network error: Unable to reach endpoint';
          } finally {
            this.loading = false;
          }
        }
      }"
    >
      <form class="card-body p-4 space-y-4" @submit.prevent="submitTransaction">
        <div class="form-control">
          <label class="label py-1" for="amount">
            <span class="label-text font-medium">Amount</span>
          </label>
          <input
            type="number"
            id="amount"
            name="amount"
            step="0.01"
            min="0.01"
            required
            placeholder="0.00"
            class="input input-bordered w-full text-lg"
            x-model="amount"
          />
        </div>

        <div class="form-control">
          <label class="label py-1" for="card">
            <span class="label-text font-medium flex items-center gap-1">
              <IconCreditCard class="w-4 h-4" />
              Card
            </span>
          </label>
          <input
            type="text"
            id="card"
            name="card"
            required
            placeholder="e.g. Amex Gold"
            class="input input-bordered w-full"
            x-model="card"
          />
        </div>

        <div class="form-control">
          <label class="label py-1" for="category">
            <span class="label-text font-medium">Category</span>
          </label>
          <input
            type="text"
            id="category"
            name="category"
            required
            placeholder="e.g. Dining"
            class="input input-bordered w-full"
            x-model="category"
          />
        </div>

        <div class="form-control">
          <label class="label py-1" for="merchant">
            <span class="label-text font-medium">Merchant</span>
          </label>
          <input
            type="text"
            id="merchant"
            name="merchant"
            required
            placeholder="e.g. Trader Joe's"
            class="input input-bordered w-full"
            x-model="merchant"
          />
        </div>

        <div class="pt-2">
          <button
            type="submit"
            class="btn btn-primary w-full min-h-[44px]"
            :disabled="loading"
          >
            <span x-show="!loading">Save Transaction</span>
            <span x-show="loading" class="loading loading-spinner loading-sm"></span>
          </button>
        </div>

        <div
          x-show="statusMessage"
          x-text="statusMessage"
          :class="isError ? 'alert alert-error text-sm py-2' : 'alert alert-success text-sm py-2'"
          role="status"
          aria-live="polite"
        ></div>
      </form>
    </section>
  </main>
</Layout>
