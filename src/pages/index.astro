---
import {
  IconBackspace,
  IconCalendar,
  IconHistory,
  IconReceipt2,
  IconSettings,
  IconX,
} from "@tabler/icons-astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="SnapTally Intake">
  <div
    class="flex flex-col min-h-dvh max-w-md mx-auto px-4 py-2 justify-between overflow-y-auto overscroll-none"
    x-data="intakeForm"
    x-init="init()"
  >
    <!-- Header -->
    <header class="flex items-center justify-between pb-1.5 border-b border-base-content/10">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-xl neu-raised-sm flex items-center justify-center text-primary">
          <IconReceipt2 class="w-5 h-5" />
        </div>
        <span class="text-lg font-bold tracking-tight text-neu-text">SnapTally</span>
      </div>

      <!-- Date selector chip -->
      <div class="relative focus-within:ring-2 focus-within:ring-primary/40 rounded-full">
        <input
          type="date"
          class="absolute inset-0 opacity-0 cursor-pointer w-full h-full"
          :value="date"
          @change="setDate($event.target.value)"
          aria-label="Transaction Date"
        />
        <button
          type="button"
          class="neu-raised-sm rounded-full px-3 py-1.5 min-h-[44px] inline-flex items-center gap-1.5 text-xs sm:text-sm font-medium pointer-events-none transition-all"
          :class="isBackfill ? 'text-warning font-semibold outline outline-1 outline-warning/50' : 'text-neu-text'"
        >
          <IconCalendar class="w-4 h-4 text-primary" />
          <span x-text="isToday ? 'Today' : date"></span>
        </button>
      </div>

      <!-- Actions: Recent & Settings -->
      <div class="flex items-center gap-2">
        <button
          type="button"
          class="w-11 h-11 rounded-full neu-raised-sm neu-pressed flex items-center justify-center text-neu-text transition-all min-h-[44px] min-w-[44px]"
          @click="toggleRecent()"
          aria-label="Recent Transactions"
        >
          <IconHistory class="w-5 h-5" />
        </button>
        <button
          type="button"
          class="w-11 h-11 rounded-full neu-raised-sm neu-pressed flex items-center justify-center text-neu-text transition-all min-h-[44px] min-w-[44px] relative"
          @click="openSettings()"
          aria-label="Settings"
        >
          <IconSettings class="w-5 h-5" />
          <span
            class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full ring-2 ring-[var(--neu-surface)]"
            :class="hasToken ? 'bg-success' : 'bg-warning'"
          ></span>
        </button>
      </div>
    </header>

    <!-- Status Message Alert -->
    <div
      x-show="statusMessage"
      x-transition
      class="text-xs text-center py-0.5 font-medium"
      :class="isError ? 'text-error' : 'text-success'"
      role="status"
      aria-live="polite"
      x-text="statusMessage"
    ></div>

    <!-- Amount Display (Debossed / Inset container) -->
    <section class="w-full py-0.5 sm:py-1 select-none">
      <div class="neu-inset rounded-2xl py-2 sm:py-2.5 px-4 flex flex-col items-center justify-center transition-all duration-75">
        <div
          class="text-4xl sm:text-5xl font-mono font-bold tracking-tight text-neu-text"
          x-text="formattedAmount"
          aria-live="off"
        >
          $0.00
        </div>
      </div>
    </section>

    <!-- Selectors Section -->
    <section class="space-y-1.5 text-xs sm:text-sm">
      <!-- Merchant Chips -->
      <div class="space-y-1" role="group" aria-label="Merchant selection">
        <div class="flex items-center gap-2 overflow-x-auto no-scrollbar scroll-mask-right -mx-2.5 px-2.5 pr-8 py-1">
          <template x-for="m in frequentMerchants" :key="m">
            <button
              type="button"
              class="neu-pressed rounded-full px-3 py-1.5 whitespace-nowrap min-h-[44px] text-xs sm:text-sm transition-all"
              :class="merchant === m && !isCustomMerchant ? 'neu-inset-sm font-bold text-primary bg-primary/10 outline outline-1 outline-primary/60' : 'neu-raised-sm font-medium text-neu-text'"
              @click="selectMerchant(m)"
              x-text="m"
            ></button>
          </template>
          <button
            type="button"
            class="neu-pressed rounded-full px-3 py-1.5 whitespace-nowrap min-h-[44px] text-xs sm:text-sm transition-all"
            :class="isCustomMerchant ? 'neu-inset-sm font-bold text-primary bg-primary/10 outline outline-1 outline-primary/60' : 'neu-raised-sm font-medium text-neu-text'"
            @click="toggleCustomMerchant()"
          >
            Other...
          </button>
        </div>
        <div x-show="isCustomMerchant" x-transition>
          <input
            type="text"
            placeholder="Type merchant name..."
            class="neu-inset w-full rounded-xl px-3 py-2 text-base text-neu-text focus:outline-none focus:ring-2 focus:ring-primary/40 mt-1"
            x-model="customMerchantInput"
            @input="updateCustomMerchant($event.target.value)"
          />
        </div>
      </div>

      <!-- Parent Bucket Chips -->
      <div class="flex items-center gap-2 overflow-x-auto no-scrollbar scroll-mask-right -mx-2.5 px-2.5 pr-8 py-1" role="group" aria-label="Parent bucket selection">
        <template x-for="b in buckets" :key="b">
          <button
            type="button"
            class="neu-pressed rounded-full px-3 py-1.5 whitespace-nowrap min-h-[44px] text-xs sm:text-sm transition-all"
            :class="parentBucket === b ? 'neu-inset-sm font-bold text-secondary bg-secondary/10 outline outline-1 outline-secondary/60' : 'neu-raised-sm font-medium text-neu-text'"
            @click="selectBucket(b)"
            x-text="b"
          ></button>
        </template>
      </div>

      <!-- Dynamic Subcategory Chips -->
      <div class="flex items-center gap-2 overflow-x-auto no-scrollbar scroll-mask-right -mx-2.5 px-2.5 pr-8 py-1" role="group" aria-label="Subcategory selection">
        <template x-for="s in subcategories" :key="s">
          <button
            type="button"
            class="neu-pressed rounded-full px-3 py-1.5 whitespace-nowrap min-h-[44px] text-xs sm:text-sm transition-all"
            :class="subcategory === s ? 'neu-inset-sm font-bold text-accent bg-accent/10 outline outline-1 outline-accent/60' : 'neu-raised-sm font-medium text-neu-text'"
            @click="selectSubcategory(s)"
            x-text="s"
          ></button>
        </template>
      </div>

      <!-- Card Selection Chips -->
      <div class="space-y-1" role="group" aria-label="Payment card selection">
        <div class="flex items-center gap-2 overflow-x-auto no-scrollbar scroll-mask-right -mx-2.5 px-2.5 pr-8 py-1">
          <template x-for="c in cards" :key="c">
            <button
              type="button"
              class="neu-pressed rounded-full px-3 py-1.5 whitespace-nowrap min-h-[44px] text-xs sm:text-sm transition-all"
              :class="card === c && !isCustomCard ? 'neu-inset-sm font-bold text-primary bg-primary/10 outline outline-1 outline-primary/60' : 'neu-raised-sm font-medium text-neu-text'"
              @click="selectCard(c)"
              x-text="c"
            ></button>
          </template>
          <button
            type="button"
            class="neu-pressed rounded-full px-3 py-1.5 whitespace-nowrap min-h-[44px] text-xs sm:text-sm transition-all"
            :class="isCustomCard ? 'neu-inset-sm font-bold text-primary bg-primary/10 outline outline-1 outline-primary/60' : 'neu-raised-sm font-medium text-neu-text'"
            @click="toggleCustomCard()"
          >
            Other...
          </button>
        </div>
        <div x-show="isCustomCard" x-transition>
          <input
            type="text"
            placeholder="Type card name..."
            class="neu-inset w-full rounded-xl px-3 py-2 text-base text-neu-text focus:outline-none focus:ring-2 focus:ring-primary/40 mt-1"
            x-model="customCardInput"
            @input="updateCustomCard($event.target.value)"
          />
        </div>
      </div>
    </section>

    <!-- Built-in Numeric Keypad (3x4 Grid) -->
    <section class="grid grid-cols-3 gap-2 pt-1 select-none">
      <button
        type="button"
        class="neu-key text-xl sm:text-2xl font-semibold h-11 sm:h-12 rounded-2xl min-h-[44px] flex items-center justify-center"
        :disabled="loading"
        @click="pressDigit(1)"
      >
        1
      </button>
      <button
        type="button"
        class="neu-key text-xl sm:text-2xl font-semibold h-11 sm:h-12 rounded-2xl min-h-[44px] flex items-center justify-center"
        :disabled="loading"
        @click="pressDigit(2)"
      >
        2
      </button>
      <button
        type="button"
        class="neu-key text-xl sm:text-2xl font-semibold h-11 sm:h-12 rounded-2xl min-h-[44px] flex items-center justify-center"
        :disabled="loading"
        @click="pressDigit(3)"
      >
        3
      </button>

      <button
        type="button"
        class="neu-key text-xl sm:text-2xl font-semibold h-11 sm:h-12 rounded-2xl min-h-[44px] flex items-center justify-center"
        :disabled="loading"
        @click="pressDigit(4)"
      >
        4
      </button>
      <button
        type="button"
        class="neu-key text-xl sm:text-2xl font-semibold h-11 sm:h-12 rounded-2xl min-h-[44px] flex items-center justify-center"
        :disabled="loading"
        @click="pressDigit(5)"
      >
        5
      </button>
      <button
        type="button"
        class="neu-key text-xl sm:text-2xl font-semibold h-11 sm:h-12 rounded-2xl min-h-[44px] flex items-center justify-center"
        :disabled="loading"
        @click="pressDigit(6)"
      >
        6
      </button>

      <button
        type="button"
        class="neu-key text-xl sm:text-2xl font-semibold h-11 sm:h-12 rounded-2xl min-h-[44px] flex items-center justify-center"
        :disabled="loading"
        @click="pressDigit(7)"
      >
        7
      </button>
      <button
        type="button"
        class="neu-key text-xl sm:text-2xl font-semibold h-11 sm:h-12 rounded-2xl min-h-[44px] flex items-center justify-center"
        :disabled="loading"
        @click="pressDigit(8)"
      >
        8
      </button>
      <button
        type="button"
        class="neu-key text-xl sm:text-2xl font-semibold h-11 sm:h-12 rounded-2xl min-h-[44px] flex items-center justify-center"
        :disabled="loading"
        @click="pressDigit(9)"
      >
        9
      </button>

      <button
        type="button"
        class="neu-key text-base sm:text-lg font-bold text-warning h-11 sm:h-12 rounded-2xl min-h-[44px] flex items-center justify-center"
        :disabled="loading"
        @click="pressClear()"
        aria-label="Clear Amount"
      >
        C
      </button>
      <button
        type="button"
        class="neu-key text-xl sm:text-2xl font-semibold h-11 sm:h-12 rounded-2xl min-h-[44px] flex items-center justify-center"
        :disabled="loading"
        @click="pressDigit(0)"
      >
        0
      </button>
      <button
        type="button"
        class="neu-key text-base sm:text-lg font-semibold text-error/90 h-11 sm:h-12 rounded-2xl min-h-[44px] flex items-center justify-center"
        :disabled="loading"
        @click="pressBackspace()"
        aria-label="Backspace"
      >
        <IconBackspace class="w-5 h-5 sm:w-6 sm:h-6" />
      </button>
    </section>

    <!-- Action Button -->
    <footer class="pt-1.5 pb-1">
      <button
        type="button"
        class="neu-convex neu-pressed w-full h-11 sm:h-12 rounded-2xl text-base font-bold min-h-[44px] flex items-center justify-center transition-all disabled:cursor-not-allowed"
        :class="amountCents > 0 ? 'text-primary' : 'text-neu-text-muted/60'"
        :disabled="loading || amountCents <= 0"
        @click="submitTransaction()"
      >
        <span x-show="!loading">Save Transaction</span>
        <span x-show="loading" class="loading loading-spinner loading-sm"></span>
      </button>
    </footer>

    <!-- Settings Modal -->
    <dialog class="modal" :class="{ 'modal-open': isSettingsOpen }">
      <div class="modal-box p-5 max-w-sm rounded-2xl max-h-[85vh] overflow-y-auto neu-raised">
        <h3 class="font-bold text-lg text-neu-text">Settings</h3>
        <p class="text-xs text-neu-text-muted mt-1">
          Configure pre-shared API bearer token stored locally in browser storage.
        </p>
        <div class="form-control my-4">
          <label class="label py-1" for="api-token-input">
            <span class="label-text font-medium text-xs text-neu-text">API Bearer Token</span>
          </label>
          <input
            type="password"
            id="api-token-input"
            class="neu-inset w-full rounded-xl px-3 py-2 text-base text-neu-text focus:outline-none focus:ring-2 focus:ring-primary/40 mt-1"
            placeholder="Paste token here"
            x-model="settingsTokenInput"
          />
        </div>
        <div class="modal-action mt-4 flex justify-end gap-2">
          <button type="button" class="neu-raised-sm neu-pressed rounded-xl px-4 py-2 text-xs font-medium text-neu-text min-h-[44px]" @click="closeSettings()">
            Cancel
          </button>
          <button type="button" class="neu-convex neu-pressed rounded-xl px-4 py-2 text-xs font-bold text-primary min-h-[44px]" @click="saveToken()">
            Save Token
          </button>
        </div>
      </div>
    </dialog>

    <!-- Recent Transactions Modal -->
    <dialog class="modal" :class="{ 'modal-open': isRecentOpen }">
      <div class="modal-box p-5 max-w-sm rounded-2xl max-h-[85vh] flex flex-col neu-raised">
        <div class="flex items-center justify-between pb-3 border-b border-base-content/10">
          <h3 class="font-bold text-lg flex items-center gap-2 text-neu-text">
            <IconHistory class="w-5 h-5 text-primary" />
            Recent Activity
          </h3>
          <button
            type="button"
            class="w-11 h-11 rounded-full neu-raised-sm neu-pressed flex items-center justify-center text-neu-text min-h-[44px] min-w-[44px]"
            @click="toggleRecent()"
            aria-label="Close Recent Transactions"
          >
            <IconX class="w-4 h-4" />
          </button>
        </div>

        <div class="overflow-y-auto flex-1 py-2 divide-y divide-base-content/10">
          <template x-if="recentTransactions.length === 0">
            <p class="text-sm text-neu-text-muted text-center py-6">
              No recent transactions recorded yet.
            </p>
          </template>

          <template x-for="tx in recentTransactions" :key="tx.id">
            <div class="py-2.5 flex items-center justify-between">
              <div class="min-w-0 pr-2">
                <div class="font-semibold text-sm truncate text-neu-text" x-text="tx.merchant"></div>
                <div class="text-xs text-neu-text-muted flex items-center gap-1.5 mt-0.5">
                  <span x-text="tx.subcategory"></span>
                  <span>&bull;</span>
                  <span x-text="tx.card"></span>
                  <span>&bull;</span>
                  <span x-text="tx.date"></span>
                </div>
              </div>
              <div class="font-mono font-bold text-sm text-right whitespace-nowrap text-neu-text">
                $<span x-text="Number(tx.net_spend).toFixed(2)"></span>
              </div>
            </div>
          </template>
        </div>

        <div class="pt-2 border-t border-base-content/10">
          <button
            type="button"
            class="neu-raised-sm neu-pressed w-full rounded-xl py-2.5 text-xs font-semibold text-neu-text min-h-[44px]"
            @click="toggleRecent()"
          >
            Close
          </button>
        </div>
      </div>
    </dialog>
  </div>
</Layout>
