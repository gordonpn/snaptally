---
import {
  IconBackspace,
  IconCalendar,
  IconHistory,
  IconReceipt2,
  IconSettings,
  IconX,
} from "@tabler/icons-astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="SnapTally Intake">
  <div
    class="flex flex-col h-full min-h-screen max-w-md mx-auto pt-safe pl-safe pr-safe justify-between overflow-hidden overflow-x-hidden overscroll-none"
    x-data="intakeForm"
  >
    <!-- Header -->
    <header class="flex-none flex flex-wrap gap-2 items-center justify-between pb-1.5 border-b border-base-content/10">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-xl neu-raised-sm flex items-center justify-center text-primary">
          <IconReceipt2 class="w-5 h-5" />
        </div>
        <span class="text-lg font-bold tracking-tight text-neu-text">SnapTally</span>
      </div>

      <!-- Date selector chip -->
      <div class="relative focus-within:ring-2 focus-within:ring-primary/40 rounded-full">
        <input
          type="date"
          class="absolute inset-0 opacity-0 cursor-pointer w-full h-full"
          :value="date"
          @change="setDate($event.target.value)"
          aria-label="Transaction Date"
        />
        <button
          type="button"
          class="neu-raised-sm rounded-full px-3 py-1.5 min-h-[44px] inline-flex items-center gap-1.5 text-xs sm:text-sm font-medium pointer-events-none transition-all"
          :class="isBackfill ? 'text-warning font-semibold outline outline-1 outline-warning/50' : 'text-neu-text'"
        >
          <IconCalendar class="w-4 h-4 text-primary" />
          <span x-text="isToday ? 'Today' : date"></span>
        </button>
      </div>

      <!-- Actions: Recent, Outbox & Settings -->
      <div class="flex items-center gap-2">
        <button
          type="button"
          x-show="outboxCount > 0"
          x-transition
          class="badge badge-warning gap-1 font-mono cursor-pointer min-h-[44px] min-w-[44px] px-2.5 neu-pressed"
          @click="openOutboxDrawer('pending')"
          aria-label="Pending offline transactions"
          title="Open pending transactions"
        >
          <span x-show="isSyncing" class="loading loading-spinner loading-xs"></span>
          <span x-text="outboxCount"></span>
        </button>
        <button
          type="button"
          x-show="deadLetterCount > 0"
          class="badge badge-error gap-1 font-mono min-h-[44px] min-w-[44px] px-2.5 neu-pressed"
          @click="openOutboxDrawer('failed')"
          aria-label="Failed transactions"
          title="Open failed transactions"
        >
          <span aria-hidden="true">!</span>
          <span x-text="deadLetterCount"></span>
        </button>
        <button
          type="button"
          class="w-11 h-11 rounded-full neu-raised-sm neu-pressed flex items-center justify-center text-neu-text transition-all min-h-[44px] min-w-[44px]"
          @click="toggleRecent()"
          aria-label="Recent Transactions"
        >
          <IconHistory class="w-5 h-5" />
        </button>
        <button
          type="button"
          class="w-11 h-11 rounded-full neu-raised-sm neu-pressed flex items-center justify-center text-neu-text transition-all min-h-[44px] min-w-[44px] relative"
          @click="openSettings()"
          aria-label="Settings"
        >
          <IconSettings class="w-5 h-5" />
          <span
            class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full ring-2 ring-[var(--neu-surface)]"
            :class="hasToken ? 'bg-success' : 'bg-warning'"
          ></span>
        </button>
      </div>
    </header>

    <div
      x-show="persistentSyncMessage"
      class="flex-none rounded-xl neu-inset border-l-4 border-error p-2 text-xs text-neu-text flex items-center gap-2"
      role="status"
      aria-live="polite"
    >
      <span class="flex-1" x-text="persistentSyncMessage"></span>
      <button type="button" class="neu-raised-sm rounded-lg px-2 min-h-[44px] font-semibold"
        @click="authenticationFailed ? openSettings() : openOutboxDrawer('failed')"
        x-text="authenticationFailed ? 'Settings' : 'Review'"></button>
    </div>

    <!-- Scrollable content area -->
    <main class="flex-1 flex flex-col justify-between overflow-y-auto overflow-x-hidden w-full max-w-full no-scrollbar py-1">

    <!-- Status Message Alert -->
    <div
      x-show="statusMessage"
      x-transition
      class="text-xs text-center py-0.5 font-medium"
      :class="isError ? 'text-error' : 'text-success'"
      role="status"
      aria-live="polite"
      x-text="statusMessage"
    ></div>

    <!-- Amount Display (Debossed / Inset container) -->
    <section class="w-full py-0.5 sm:py-1 select-none">
      <div class="neu-inset rounded-2xl py-2 sm:py-2.5 px-4 flex items-center justify-between transition-all duration-75 relative">
        <button
          type="button"
          class="neu-pressed rounded-xl w-11 h-11 min-h-[44px] min-w-[44px] flex items-center justify-center font-bold text-lg transition-all disabled:opacity-50 disabled:cursor-not-allowed"
          :class="isNegative ? 'neu-inset-sm text-secondary bg-secondary/10 outline outline-1 outline-secondary/60' : 'neu-raised-sm text-neu-text-muted'"
          :disabled="loading || parentBucket === 'Income'"
          @click="toggleNegative()"
          :aria-pressed="isNegative"
          aria-label="Credit mode"
        >
          &plusmn;
        </button>
        <div class="flex-1 flex flex-col items-center justify-center min-w-0">
          <div
            class="font-mono font-bold tracking-tight text-center transition-all truncate max-w-full"
            :class="[
              isNegative ? 'text-secondary' : 'text-neu-text',
              amountFontSizeClass
            ]"
            x-text="(isNegative ? '-' : '') + formattedAmount"
            aria-live="off"
          >
            $0.00
          </div>
          <template x-if="isNegative">
            <span class="text-[10px] font-bold uppercase tracking-wider text-secondary mt-0.5 whitespace-nowrap">Refund / Credit</span>
          </template>
        </div>
        <div class="w-11 min-w-[44px] pointer-events-none" aria-hidden="true"></div>
      </div>
    </section>

    <!-- Selectors Section -->
    <section class="space-y-1.5 text-xs sm:text-sm">
      <!-- Merchant Chips -->
      <div class="space-y-1" role="group" aria-label="Merchant selection">
        <div class="flex items-center gap-2 overflow-x-auto no-scrollbar scroll-mask-right py-1 px-1">
          <template x-for="m in frequentMerchants" :key="m">
            <button
              type="button"
              class="neu-pressed rounded-full px-3 py-1.5 whitespace-nowrap min-h-[44px] text-xs sm:text-sm transition-all"
              :class="merchant === m && !isCustomMerchant ? 'neu-inset-sm font-bold text-primary bg-primary/10 outline outline-1 outline-primary/60' : 'neu-raised-sm font-medium text-neu-text'"
              :aria-pressed="merchant === m && !isCustomMerchant"
              @click="selectMerchant(m)"
              x-text="m"
            ></button>
          </template>
          <button
            type="button"
            class="neu-pressed rounded-full px-3 py-1.5 whitespace-nowrap min-h-[44px] text-xs sm:text-sm transition-all"
            :class="isCustomMerchant ? 'neu-inset-sm font-bold text-primary bg-primary/10 outline outline-1 outline-primary/60' : 'neu-raised-sm font-medium text-neu-text'"
            :aria-pressed="isCustomMerchant"
            @click="toggleCustomMerchant()"
          >
            Other...
          </button>
        </div>
        <div x-show="isCustomMerchant" x-transition class="relative mt-1" @click.outside="closeMerchantSuggestions()">
          <input
            id="custom-merchant-input"
            type="text"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            placeholder="Type merchant name..."
            class="neu-inset w-full rounded-xl px-3 py-2 text-base text-neu-text focus:outline-none focus:ring-2 focus:ring-primary/40"
            x-model="customMerchantInput"
            @input="updateCustomMerchant($event.target.value)"
            @focus="onCustomMerchantFocus()"
            @keydown="handleCustomMerchantKeydown($event)"
            role="combobox"
            aria-autocomplete="list"
            :aria-expanded="merchantSuggestionsOpen && merchantSuggestions.length > 0"
            aria-controls="merchant-suggestions-list"
            :aria-activedescendant="highlightedMerchantIndex >= 0 ? `merchant-opt-${highlightedMerchantIndex}` : undefined"
          />
          <ul
            id="merchant-suggestions-list"
            role="listbox"
            aria-label="Merchant suggestions"
            x-show="merchantSuggestionsOpen && merchantSuggestions.length > 0"
            x-transition
            class="absolute z-30 left-0 right-0 top-full mt-1 neu-raised-sm rounded-xl overflow-hidden shadow-lg border border-base-content/10 bg-[var(--neu-surface)] py-1 max-h-48 overflow-y-auto no-scrollbar"
          >
            <template x-for="(s, index) in merchantSuggestions" :key="s">
              <li
                :id="`merchant-opt-${index}`"
                role="option"
                :aria-selected="highlightedMerchantIndex === index"
                class="w-full text-left px-3 py-2 text-sm text-neu-text transition-colors flex items-center justify-between cursor-pointer select-none"
                :class="highlightedMerchantIndex === index ? 'neu-inset-sm font-semibold text-primary bg-primary/10' : 'hover:bg-base-content/5'"
                @mouseenter="highlightedMerchantIndex = index; highlightedMerchant = s"
                @mousedown.prevent
                @click="chooseMerchantSuggestion(s)"
              >
                <span x-text="s"></span>
              </li>
            </template>
          </ul>
        </div>
      </div>

      <!-- Parent Bucket Chips -->
      <div class="flex items-center gap-2 overflow-x-auto no-scrollbar scroll-mask-right py-1 px-1" role="group" aria-label="Parent bucket selection">
        <template x-for="b in buckets" :key="b">
          <button
            type="button"
            class="neu-pressed rounded-full px-3 py-1.5 whitespace-nowrap min-h-[44px] text-xs sm:text-sm transition-all disabled:opacity-50 disabled:cursor-not-allowed"
            :class="parentBucket === b ? 'neu-inset-sm font-bold text-secondary bg-secondary/10 outline outline-1 outline-secondary/60' : 'neu-raised-sm font-medium text-neu-text'"
            :aria-pressed="parentBucket === b"
            :disabled="isNegative && b === 'Income'"
            @click="selectBucket(b)"
            x-text="b"
          ></button>
        </template>
      </div>

      <!-- Dynamic Subcategory Chips -->
      <div class="flex items-center gap-2 overflow-x-auto no-scrollbar scroll-mask-right py-1 px-1" role="group" aria-label="Subcategory selection">
        <template x-for="s in subcategories" :key="s">
          <button
            type="button"
            class="neu-pressed rounded-full px-3 py-1.5 whitespace-nowrap min-h-[44px] text-xs sm:text-sm transition-all"
            :class="subcategory === s ? 'neu-inset-sm font-bold text-accent bg-accent/10 outline outline-1 outline-accent/60' : 'neu-raised-sm font-medium text-neu-text'"
            :aria-pressed="subcategory === s"
            @click="selectSubcategory(s)"
            x-text="s"
          ></button>
        </template>
      </div>

      <!-- Card Selection Chips -->
      <div class="space-y-1" role="group" aria-label="Payment card selection">
        <div class="flex items-center gap-2 overflow-x-auto no-scrollbar scroll-mask-right py-1 px-1">
          <template x-for="c in cards" :key="c">
            <button
              type="button"
              class="neu-pressed rounded-full px-3 py-1.5 whitespace-nowrap min-h-[44px] text-xs sm:text-sm transition-all"
              :class="card === c && !isCustomCard ? 'neu-inset-sm font-bold text-primary bg-primary/10 outline outline-1 outline-primary/60' : 'neu-raised-sm font-medium text-neu-text'"
              :aria-pressed="card === c && !isCustomCard"
              @click="selectCard(c)"
              x-text="c"
            ></button>
          </template>
          <button
            type="button"
            class="neu-pressed rounded-full px-3 py-1.5 whitespace-nowrap min-h-[44px] text-xs sm:text-sm transition-all"
            :class="isCustomCard ? 'neu-inset-sm font-bold text-primary bg-primary/10 outline outline-1 outline-primary/60' : 'neu-raised-sm font-medium text-neu-text'"
            :aria-pressed="isCustomCard"
            @click="toggleCustomCard()"
          >
            Other...
          </button>
        </div>
        <div x-show="isCustomCard" x-transition>
          <input
            type="text"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            placeholder="Type card name..."
            class="neu-inset w-full rounded-xl px-3 py-2 text-base text-neu-text focus:outline-none focus:ring-2 focus:ring-primary/40 mt-1"
            x-model="customCardInput"
            @input="updateCustomCard($event.target.value)"
          />
        </div>
      </div>
    </section>

    <!-- Built-in Numeric Keypad (3x4 Grid) -->
    <section class="grid grid-cols-3 gap-2 pt-1 select-none">
      <button
        type="button"
        class="neu-key text-xl sm:text-2xl font-semibold h-11 sm:h-12 rounded-2xl min-h-[44px] flex items-center justify-center"
        :disabled="loading"
        @click="pressDigit(1)"
      >
        1
      </button>
      <button
        type="button"
        class="neu-key text-xl sm:text-2xl font-semibold h-11 sm:h-12 rounded-2xl min-h-[44px] flex items-center justify-center"
        :disabled="loading"
        @click="pressDigit(2)"
      >
        2
      </button>
      <button
        type="button"
        class="neu-key text-xl sm:text-2xl font-semibold h-11 sm:h-12 rounded-2xl min-h-[44px] flex items-center justify-center"
        :disabled="loading"
        @click="pressDigit(3)"
      >
        3
      </button>

      <button
        type="button"
        class="neu-key text-xl sm:text-2xl font-semibold h-11 sm:h-12 rounded-2xl min-h-[44px] flex items-center justify-center"
        :disabled="loading"
        @click="pressDigit(4)"
      >
        4
      </button>
      <button
        type="button"
        class="neu-key text-xl sm:text-2xl font-semibold h-11 sm:h-12 rounded-2xl min-h-[44px] flex items-center justify-center"
        :disabled="loading"
        @click="pressDigit(5)"
      >
        5
      </button>
      <button
        type="button"
        class="neu-key text-xl sm:text-2xl font-semibold h-11 sm:h-12 rounded-2xl min-h-[44px] flex items-center justify-center"
        :disabled="loading"
        @click="pressDigit(6)"
      >
        6
      </button>

      <button
        type="button"
        class="neu-key text-xl sm:text-2xl font-semibold h-11 sm:h-12 rounded-2xl min-h-[44px] flex items-center justify-center"
        :disabled="loading"
        @click="pressDigit(7)"
      >
        7
      </button>
      <button
        type="button"
        class="neu-key text-xl sm:text-2xl font-semibold h-11 sm:h-12 rounded-2xl min-h-[44px] flex items-center justify-center"
        :disabled="loading"
        @click="pressDigit(8)"
      >
        8
      </button>
      <button
        type="button"
        class="neu-key text-xl sm:text-2xl font-semibold h-11 sm:h-12 rounded-2xl min-h-[44px] flex items-center justify-center"
        :disabled="loading"
        @click="pressDigit(9)"
      >
        9
      </button>

      <button
        type="button"
        class="neu-key text-base sm:text-lg font-bold text-warning h-11 sm:h-12 rounded-2xl min-h-[44px] flex items-center justify-center"
        :disabled="loading"
        @click="pressClear()"
        aria-label="Clear Amount"
      >
        C
      </button>
      <button
        type="button"
        class="neu-key text-xl sm:text-2xl font-semibold h-11 sm:h-12 rounded-2xl min-h-[44px] flex items-center justify-center"
        :disabled="loading"
        @click="pressDigit(0)"
      >
        0
      </button>
      <button
        type="button"
        class="neu-key text-base sm:text-lg font-semibold text-error/90 h-11 sm:h-12 rounded-2xl min-h-[44px] flex items-center justify-center"
        :disabled="loading"
        @click="pressBackspace()"
        aria-label="Backspace"
      >
        <IconBackspace class="w-5 h-5 sm:w-6 sm:h-6" />
      </button>
    </section>
    </main>

    <!-- Action Button -->
    <footer class="flex-none pt-1 pb-safe">
      <button
        type="button"
        class="neu-convex neu-pressed w-full h-11 sm:h-12 rounded-2xl text-base font-bold min-h-[44px] flex items-center justify-center transition-all disabled:cursor-not-allowed"
        :class="amountCents > 0 ? (isNegative ? 'text-secondary' : 'text-primary') : 'text-neu-text-muted/60'"
        :disabled="loading || amountCents <= 0"
        @click="submitTransaction()"
      >
        <span x-show="!loading" x-text="submitButtonLabel">Save Transaction</span>
        <span x-show="loading" class="loading loading-spinner loading-sm"></span>
      </button>
    </footer>

    <dialog
      class="modal modal-bottom sm:modal-middle"
      aria-labelledby="sync-status-title"
      x-effect="isOutboxOpen ? $el.showModal() : $el.close()"
      @cancel="closeOutboxDrawer()"
      @close="closeOutboxDrawer()"
    >
      <template x-if="isOutboxOpen">
        <div class="modal-box p-4 pb-safe max-w-sm rounded-t-2xl sm:rounded-2xl max-h-[85dvh] flex flex-col neu-raised">
          <div class="flex items-center justify-between gap-2">
            <h2 id="sync-status-title" class="font-bold text-lg text-neu-text">Sync Status</h2>
            <span x-show="isSyncing" class="loading loading-spinner loading-sm" role="status" aria-label="Syncing transactions"></span>
            <button type="button" class="neu-raised-sm rounded-full min-h-[44px] min-w-[44px] flex items-center justify-center"
              @click="closeOutboxDrawer()" aria-label="Close Sync Status" autofocus>
              <IconX class="w-5 h-5" />
            </button>
          </div>
          <div class="flex gap-2 my-3" role="group" aria-label="Transaction queues">
            <button type="button" class="flex-1 rounded-xl min-h-[44px] text-sm font-semibold"
              :class="activeOutboxTab === 'pending' ? 'neu-inset text-primary' : 'neu-raised-sm text-neu-text'"
              :aria-pressed="activeOutboxTab === 'pending'" @click="activeOutboxTab = 'pending'">
              Pending (<span x-text="outboxCount"></span>)
            </button>
            <button type="button" class="flex-1 rounded-xl min-h-[44px] text-sm font-semibold"
              :class="activeOutboxTab === 'failed' ? 'neu-inset text-neu-text' : 'neu-raised-sm text-neu-text'"
              :aria-pressed="activeOutboxTab === 'failed'" @click="activeOutboxTab = 'failed'">
              Failed (<span x-text="deadLetterCount"></span>)
            </button>
          </div>
          <p x-show="authenticationFailed" class="text-neu-text text-sm mb-2" x-text="persistentSyncMessage"></p>
          <p x-show="syncError" class="text-neu-text text-sm mb-2 break-words" role="status" x-text="syncError"></p>
          <p x-show="queueError" class="text-neu-text text-sm mb-2 break-words" role="alert" x-text="queueError"></p>
          <div class="overflow-y-auto flex-1 min-h-0">
            <section x-show="activeOutboxTab === 'pending'" aria-label="Pending transactions">
              <p x-show="outboxItems.length === 0" class="text-sm text-neu-text text-center py-6">No pending transactions.</p>
              <template x-for="item in outboxItems" :key="item.id">
                <article class="neu-inset rounded-xl p-3 mb-2 text-sm">
                  <div class="flex justify-between gap-2 font-semibold">
                    <span class="break-words min-w-0" x-text="item.merchant"></span>
                    <span class="font-mono whitespace-nowrap" x-text="item.gross_amount.toLocaleString('en-US', { style: 'currency', currency: 'USD' })"></span>
                  </div>
                  <p class="text-xs text-neu-text mt-1"><span x-text="item.date"></span> · Retries: <span x-text="retryCount(item)"></span></p>
                </article>
              </template>
            </section>
            <section x-show="activeOutboxTab === 'failed'" aria-label="Failed transactions">
              <p x-show="deadLetterItems.length === 0" class="text-sm text-neu-text text-center py-6">No failed transactions.</p>
              <template x-for="item in deadLetterItems" :key="item.id">
                <article class="neu-inset rounded-xl p-3 mb-2 text-sm">
                  <div class="flex justify-between gap-2 font-semibold">
                    <span class="break-words min-w-0" x-text="item.payload.merchant"></span>
                    <span class="font-mono whitespace-nowrap" x-text="item.payload.gross_amount.toLocaleString('en-US', { style: 'currency', currency: 'USD' })"></span>
                  </div>
                  <p class="text-xs text-neu-text mt-1"><span x-text="item.payload.date"></span> · Retries: <span x-text="Math.max(item.retry_count, retryCount(item.payload))"></span></p>
                  <template x-if="item.http_status !== undefined">
                    <p class="text-xs text-neu-text mt-1">HTTP <span x-text="item.http_status"></span></p>
                  </template>
                  <p class="text-neu-text font-semibold text-xs break-words mt-2" x-text="item.error_reason"></p>
                  <div class="flex gap-2 mt-2">
                    <button type="button" class="neu-raised-sm flex-1 rounded-lg min-h-[44px] text-primary font-semibold disabled:opacity-50"
                      :disabled="isQueueActionPending || isSyncing" @click="retryDLQItem(item.id)">Retry</button>
                    <button type="button" class="neu-raised-sm flex-1 rounded-lg min-h-[44px] text-neu-text font-semibold disabled:opacity-50"
                      :disabled="isQueueActionPending || isSyncing" @click="discardDLQItem(item.id)">Discard</button>
                  </div>
                </article>
              </template>
            </section>
          </div>
          <button type="button" class="neu-convex rounded-xl min-h-[44px] mt-3 text-primary font-bold disabled:opacity-50"
            x-show="activeOutboxTab === 'pending'" :disabled="isSyncing || isQueueActionPending || outboxCount === 0"
            @click="syncPendingOutbox(true)">Sync Now</button>
        </div>
      </template>
    </dialog>

    <!-- Settings Modal -->
    <dialog class="modal" :class="{ 'modal-open': isSettingsOpen }">
      <div class="modal-box p-5 max-w-sm rounded-2xl max-h-[85vh] overflow-y-auto neu-raised">
        <h3 class="font-bold text-lg text-neu-text">Settings</h3>
        <p class="text-xs text-neu-text-muted mt-1">
          Configure pre-shared API bearer token stored locally in browser storage.
        </p>
        <div class="form-control my-4">
          <label class="label py-1" for="api-token-input">
            <span class="label-text font-medium text-xs text-neu-text">API Bearer Token</span>
          </label>
          <input
            type="password"
            id="api-token-input"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            class="neu-inset w-full rounded-xl px-3 py-2 text-base text-neu-text focus:outline-none focus:ring-2 focus:ring-primary/40 mt-1"
            placeholder="Paste token here"
            x-model="settingsTokenInput"
          />
        </div>
        <div class="modal-action mt-4 flex justify-end gap-2">
          <button type="button" class="neu-raised-sm neu-pressed rounded-xl px-4 py-2 text-xs font-medium text-neu-text min-h-[44px]" @click="closeSettings()">
            Cancel
          </button>
          <button type="button" class="neu-convex neu-pressed rounded-xl px-4 py-2 text-xs font-bold text-primary min-h-[44px]" @click="saveToken()">
            Save Token
          </button>
        </div>
      </div>
    </dialog>

    <!-- Recent Transactions Modal -->
    <dialog class="modal" :class="{ 'modal-open': isRecentOpen }">
      <div class="modal-box p-5 max-w-sm rounded-2xl max-h-[85vh] flex flex-col neu-raised">
        <div class="flex items-center justify-between pb-3 border-b border-base-content/10">
          <h3 class="font-bold text-lg flex items-center gap-2 text-neu-text">
            <IconHistory class="w-5 h-5 text-primary" />
            Recent Activity
          </h3>
          <button
            type="button"
            class="w-11 h-11 rounded-full neu-raised-sm neu-pressed flex items-center justify-center text-neu-text min-h-[44px] min-w-[44px]"
            @click="toggleRecent()"
            aria-label="Close Recent Transactions"
          >
            <IconX class="w-4 h-4" />
          </button>
        </div>

        <div class="overflow-y-auto flex-1 py-2 divide-y divide-base-content/10">
          <template x-if="recentTransactions.length === 0">
            <p class="text-sm text-neu-text-muted text-center py-6">
              No recent transactions recorded yet.
            </p>
          </template>

          <template x-for="tx in recentTransactions" :key="tx.id">
            <div class="py-2.5 flex items-center justify-between">
              <div class="min-w-0 pr-2">
                <div class="font-semibold text-sm text-neu-text flex items-center gap-1.5 min-w-0">
                  <span class="truncate" x-text="tx.merchant"></span>
                  <template x-if="Number(tx.gross_amount) < 0">
                    <span class="badge badge-secondary badge-xs shrink-0">Credit</span>
                  </template>
                  <template x-if="Number(tx.reimbursement) > 0">
                    <span class="badge badge-accent badge-xs shrink-0">Split</span>
                  </template>
                </div>
                <div class="text-xs text-neu-text-muted flex items-center gap-1.5 mt-0.5">
                  <span x-text="tx.subcategory"></span>
                  <span>&bull;</span>
                  <span x-text="tx.card"></span>
                  <span>&bull;</span>
                  <span x-text="tx.date"></span>
                </div>
              </div>
              <div class="text-right whitespace-nowrap">
                <div
                  class="font-mono font-bold text-sm"
                  :class="Number(tx.net_spend) < 0 ? 'text-secondary' : 'text-neu-text'"
                >
                  <span x-text="Number(tx.net_spend) < 0 ? '-$' + Math.abs(Number(tx.net_spend)).toFixed(2) : '$' + Number(tx.net_spend).toFixed(2)"></span>
                </div>
                <template x-if="Number(tx.reimbursement) > 0">
                  <div class="text-[11px] font-mono text-neu-text-muted">
                    Gross: $<span x-text="Number(tx.gross_amount).toFixed(2)"></span>
                  </div>
                </template>
              </div>
            </div>
          </template>
        </div>

        <div class="pt-2 border-t border-base-content/10">
          <button
            type="button"
            class="neu-raised-sm neu-pressed w-full rounded-xl py-2.5 text-xs font-semibold text-neu-text min-h-[44px]"
            @click="toggleRecent()"
          >
            Close
          </button>
        </div>
      </div>
    </dialog>
  </div>
</Layout>
